<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, minimal-ui">
		{{#if resume.basics.summary}}
		<meta name="description" content="{{{resume.basics.summary}}}">
		{{/if}}
		<title>{{#resume.basics}}{{name}}'s Resume{{/resume.basics}}</title>

		<style>
			{{{standardCSS}}}
		</style>

		<style media="screen">
			{{{screenCSS}}}
		</style>

		<style media="print">
			{{{printCSS}}}
		</style>
	</head>
	<body>
		<div class="resume">
			{{#resume.basics}}
			<header class="header">
				<h1>{{name}}</h1>
				{{#if label}}
				<p class="title">{{label}}</p>
				{{/if}}
				<ul class="contact-list">
					{{#if location}}
						{{#if (or location.city location.region)}}
						<li>
							{{#if location.city}}{{location.city}}{{/if}}{{#if location.region}}{{#if location.city}}, {{/if}}{{location.region}}{{/if}}
						</li>
						{{/if}}
					{{/if}}
					{{#if phone}}
					<li>{{phone}}</li>
					{{/if}}
					{{#if email}}
					<li><a href="mailto:{{email}}">{{email}}</a></li>
					{{/if}}
					{{#if url}}
					<li><a href="{{url}}" rel="noopener">{{url}}</a></li>
					{{/if}}
					{{#if website}}
						{{#unless (eq website url)}}
						<li><a href="{{website}}" rel="noopener">{{website}}</a></li>
						{{/unless}}
					{{/if}}
					{{#if profiles.length}}
						{{#each profiles}}
							{{#if url}}
								{{#unless (or (eq url ../url) (eq url ../website))}}
								<li><a href="{{url}}" rel="noopener">{{url}}</a></li>
								{{/unless}}
							{{/if}}
						{{/each}}
					{{/if}}
				</ul>
			</header>
			{{/resume.basics}}

			{{#if resume.basics.summary}}
			<section class="section">
				<h2>Summary</h2>
				<p>{{resume.basics.summary}}</p>
			</section>
			{{/if}}

			{{#if resume.skills.length}}
			<section class="section">
				<h2>Core Skills</h2>
				<div class="skills">
					{{#each resume.skills}}
					<p>
						{{#if name}}<strong>{{name}}:</strong> {{/if}}
						{{#if keywords.length}}{{#commalist keywords}}{{.}}{{/commalist}}{{/if}}
					</p>
					{{/each}}
				</div>
			</section>
			{{/if}}

			{{#if resume.work.length}}
			<section class="section">
				<h2>Professional Experience</h2>
				{{#each resume.work}}
				<div class="entry">
					<div class="entry-head">
						<p class="entry-title">
							{{#if (or position role)}}{{#if position}}{{position}}{{else}}{{role}}{{/if}}{{/if}}
							{{#if (or company name)}}{{#if (or position role)}} — {{/if}}{{#if company}}{{company}}{{else}}{{name}}{{/if}}{{/if}}
						</p>
						{{#if startDate}}
						<p class="entry-meta">
							{{startDate}} – {{#if endDate}}{{endDate}}{{else}}Present{{/if}}
							{{#if location}}{{#if (or location.city location.region)}} | {{#if location.city}}{{location.city}}{{/if}}{{#if location.region}}{{#if location.city}}, {{/if}}{{location.region}}{{/if}}{{/if}}{{/if}}
						</p>
						{{/if}}
					</div>
					{{#if summary}}
					<p class="entry-summary">{{summary}}</p>
					{{/if}}
					{{#if highlights.length}}
					<ul class="bullets">
						{{#each highlights}}
						<li>{{.}}</li>
						{{/each}}
					</ul>
					{{/if}}
					{{#if assignments.length}}
					<div class="assignments">
						{{#each assignments}}
						<div class="entry sub-entry">
							<div class="entry-head">
								<p class="entry-title">
									{{#if (or position role)}}{{#if position}}{{position}}{{else}}{{role}}{{/if}}{{/if}}
									{{#if (or company name)}}{{#if (or position role)}} — {{/if}}{{#if company}}{{company}}{{else}}{{name}}{{/if}}{{/if}}
								</p>
								{{#if startDate}}
								<p class="entry-meta">{{startDate}} – {{#if endDate}}{{endDate}}{{else}}Present{{/if}}</p>
								{{/if}}
							</div>
							{{#if summary}}
							<p class="entry-summary">{{summary}}</p>
							{{/if}}
							{{#if highlights.length}}
							<ul class="bullets">
								{{#each highlights}}
								<li>{{.}}</li>
								{{/each}}
							</ul>
							{{/if}}
						</div>
						{{/each}}
					</div>
					{{/if}}
				</div>
				{{/each}}
			</section>
			{{/if}}

			{{#if resume.projects.length}}
			<section class="section">
				<h2>Projects</h2>
				{{#each resume.projects}}
				<div class="entry">
					<div class="entry-head">
						<p class="entry-title">
							{{#if name}}{{name}}{{/if}}
							{{#if (or entity role)}}{{#if name}} — {{/if}}{{#if role}}{{role}}{{else}}{{entity}}{{/if}}{{/if}}
						</p>
						{{#if startDate}}
						<p class="entry-meta">{{startDate}} – {{#if endDate}}{{endDate}}{{else}}Present{{/if}}</p>
						{{/if}}
						{{#if url}}
						<p class="entry-meta"><a href="{{url}}" rel="noopener">{{url}}</a></p>
						{{/if}}
					</div>
					{{#if description}}
					<p class="entry-summary">{{description}}</p>
					{{/if}}
					{{#if highlights.length}}
					<ul class="bullets">
						{{#each highlights}}
						<li>{{.}}</li>
						{{/each}}
					</ul>
					{{/if}}
				</div>
				{{/each}}
			</section>
			{{/if}}

			{{#if resume.education.length}}
			<section class="section">
				<h2>Education</h2>
				{{#each resume.education}}
				<div class="entry">
					<div class="entry-head">
						<p class="entry-title">{{#if studyType}}{{studyType}}{{/if}}{{#if area}}{{#if studyType}} in {{/if}}{{area}}{{/if}}</p>
						<p class="entry-meta">
							{{#if institution}}{{institution}}{{/if}}
							{{#if startDate}} | {{startDate}} – {{#if endDate}}{{endDate}}{{else}}Present{{/if}}{{/if}}
						</p>
					</div>
				</div>
				{{/each}}
			</section>
			{{/if}}

			{{#if resume.certificates.length}}
			<section class="section">
				<h2>Certifications</h2>
				{{#each resume.certificates}}
				<div class="entry">
					<p class="entry-title">{{name}}</p>
					{{#if date}}<p class="entry-meta">{{date}}</p>{{/if}}
					{{#if issuer}}<p class="entry-summary">{{issuer}}</p>{{/if}}
				</div>
				{{/each}}
			</section>
			{{/if}}

			{{#if resume.awards.length}}
			<section class="section">
				<h2>Awards</h2>
				{{#each resume.awards}}
				<div class="entry">
					<p class="entry-title">{{title}}</p>
					{{#if date}}<p class="entry-meta">{{date}}</p>{{/if}}
					{{#if awarder}}<p class="entry-summary">{{awarder}}</p>{{/if}}
					{{#if summary}}<p class="entry-summary">{{summary}}</p>{{/if}}
				</div>
				{{/each}}
			</section>
			{{/if}}

			{{#if resume.languages.length}}
			<section class="section">
				<h2>Languages</h2>
				<div class="skills">
					{{#each resume.languages}}
					<p>{{#if language}}{{language}}{{/if}}{{#if fluency}} ({{fluency}}){{/if}}</p>
					{{/each}}
				</div>
			</section>
			{{/if}}

			{{#if resume.interests.length}}
			<section class="section">
				<h2>Interests</h2>
				<div class="skills">
					{{#each resume.interests}}
					<p>{{#if name}}{{name}}: {{/if}}{{#if keywords.length}}{{#commalist keywords}}{{.}}{{/commalist}}{{/if}}</p>
					{{/each}}
				</div>
			</section>
			{{/if}}
		</div>
	</body>
</html>
